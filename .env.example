# Copy to .env (gitignored) and fill in. Nothing loads it automatically; export it into
# your shell first: set -a; . ./.env; set +a

# Kaggle API token (kaggle.com > Settings > API > Create New Token), for downloading the
# Olist data into data/olist.sqlite.
KAGGLE_API_TOKEN=

# To plan infra/ locally (scripts/tf-toolbox.sh). Both are GitHub secrets CI already has.
TF_VAR_operator_object_id=
TF_VAR_budget_alert_email=
